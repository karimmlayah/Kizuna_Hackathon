# ==============================================================================
# SMART SOLAR — Environment Configuration Template
# Copy this file to .env (or backend/.env) and populate with your own API keys.
# DO NOT COMMIT REAL API KEYS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini API (Recommended for Solar AI conversational agent)
# Generative Language API — https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash

# ------------------------------------------------------------------------------
# NVIDIA AI Foundation Models (Fallback inference provider)
# NVIDIA Build — https://build.nvidia.com/
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=mistralai/mistral-large-4-1t-a52b

# ------------------------------------------------------------------------------
# Smart Solar IoT Gateway Security
# Shared secret for authenticating ESP32 telemetry packets
# ------------------------------------------------------------------------------
SMART_SOLAR_IOT_API_KEY=your_secure_hex_key_here

# ------------------------------------------------------------------------------
# Cloudflare Tunnel (Optional — for remote Mokxi ESP32 simulation)
# ------------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_URL=https://your-tunnel-subdomain.trycloudflare.com
