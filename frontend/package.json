{
  "name": "smart-solar",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios:go": "node scripts/start-expo-go.cjs",
    "ios:tunnel": "node scripts/start-expo-go.cjs --tunnel",
    "backend": "cd ../backend && .venv\\Scripts\\python.exe -m uvicorn main:app --host 0.0.0.0 --port 8003",
    "web": "expo start --web",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "build:apk": "eas build --platform android --profile preview --local",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-three/fiber": "^9.8.2",
    "expo": "~58.0.26",
    "expo-av": "^16.0.8",
    "expo-constants": "~58.0.16",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-intent-launcher": "~58.0.3",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-router": "~58.0.32",
    "expo-speech": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "lucide-react-native": "^1.77.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@types/three": "^0.187.0",
    "babel-preset-expo": "~58.0.26",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "expo": "$expo"
  }
}
