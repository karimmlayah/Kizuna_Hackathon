  "projects": {
    "*": {
      "files": {
        "sketch.ino": "// A 6 V 1 W solar panel on a 36 ohm load.\n//\n// A solar panel is a current source set by the light, with the cells' own\n// diode across it. In full sun this one gives about 0.2 A into anything from\n// a short up to about 5.5 V, and about 7.2 V with nothing on it. So the load\n// decides the voltage, and the light decides the current.\n//\n// The left meter is in series on DC amps; the right one reads the panel's\n// own voltage. In full sun (the slider at 1000 W/m2):\n//\n//   current       about 161.8 mA\n//   panel volts   about 5.99 V\n//   power         about 0.97 W, near the panel's 1 W rating\n//\n// 36 ohm (plus the meter's 1 ohm shunt) is close to the load that takes the\n// most power out of this panel, its maximum power point.\n//\n// Things to try. Change the load to 100 ohm: 6.89 V but only 68 mA, about\n// 0.47 W. Change it to 10 ohm: almost the full 0.2 A but only 2.18 V, about\n// 0.43 W. Drag the sunlight to 500 and the 36 ohm load gets only about\n// 0.34 W, while 56 ohm gets about 0.44 W: in dimmer light the best load is\n// a bigger one.\n"
      },
      "main": "sketch.ino"
    },
    "esp321": {
      "files": {
        "sketch.ino": "const int solarPin = 34;\n\nvoid setup() {\n    Serial.begin(115200);\n    analogReadResolution(12);\n    analogSetPinAttenuation(solarPin, ADC_11db);\n}\n\nvoid loop() {\n    int raw = analogRead(solarPin);\n\n    float adc = analogReadMilliVolts(solarPin) / 1000.0;\n    float tension = adc * 3.0;\n\n    Serial.println(\"===== SMART SOLAR IoT =====\");\n\n    Serial.print(\"ADC brut : \");\n    Serial.println(raw);\n\n    Serial.print(\"Tension ADC : \");\n    Serial.print(adc, 3);\n    Serial.println(\" V\");\n\n    Serial.print(\"Tension solaire : \");\n    Serial.print(tension, 3);\n    Serial.println(\" V\");\n\n    Serial.println(\"==========================\");\n\n    delay(1000);\n}"
      },
      "main": "sketch.ino"
    }
  }
